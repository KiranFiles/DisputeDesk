# PayPal REST app credentials. Sandbox: https://api-m.sandbox.paypal.com  Live: https://api-m.paypal.com
# Leave the credentials blank (development only) to use built-in sample disputes.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
MOCK_PAYPAL=false

# AI triage needs ONE of these keys; the "Run AI triage" button stays disabled without it.
# AI_PROVIDER is optional: leave blank to use whichever key is set (OpenAI first).
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Guardrail: the server refuses to accept a claim above this amount.
MAX_ACCEPT_AMOUNT=250

# Required when NODE_ENV=production (password min 12 chars). /healthz is exempt.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Number of reverse-proxy hops in front of the server (needed for correct per-IP rate limiting).
TRUST_PROXY=0
PORT=3001
